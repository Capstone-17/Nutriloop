{
  "expo": {
    "name": "NutriLoop",
    "slug": "nutriloop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "../assets/Nutriloop_1.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.nutriloop.app",
      "adaptiveIcon": {
        "backgroundColor": "#0C0608",
        "foregroundImage": "../assets/Nutriloop_1.png"
      },
      "permissions": [],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-sqlite",
      "expo-font"
    ]
  }
}
